# ── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── File Storage (Cloudinary) ─────────────────────────────────────────────────
# Found in Cloudinary Dashboard → Settings → Product Environment
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# ── Sky OS Billing Integration ────────────────────────────────────────────────
SKYOS_API_KEY=your_skyos_api_key
# Update this to your production domain after deploying
SKYOS_WEBHOOK_URL=https://your-app.onrender.com/api/webhooks/skyos

# ── Sync API ──────────────────────────────────────────────────────────────────
AMAANAH_SYNC_API_KEY=your_sync_api_key

# ── OpenAI (AI Exam Scheduler) ────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── Bank Details (shown on invoices) ──────────────────────────────────────────
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NAME=Amaanah Organisation
BANK_ACCOUNT_NUMBER=1234567890
